# Copy this file to .env and fill in your own values.

# Port the API listens on locally (on Vercel the app runs as a serverless
# function and this is never read).
# Note: macOS AirPlay Receiver already occupies port 5000 — that is why
# the local default is 5001. Set PORT=5000 if you have disabled it.
PORT=5001

# MongoDB Atlas connection string, e.g.
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/todo
# Leave empty to run against an in-memory MongoDB (local dev fallback only).
MONGODB_URI=

# Comma-separated list of allowed browser origins (plan challenge C8).
# Use * to allow every origin (development).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
